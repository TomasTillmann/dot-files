# Apps configured in this repository and the tools their configs rely on.
# Install everything with: brew bundle --file ~/.dot-files/Brewfile

# Kitty terminal and the font used by Kitty, Neovim, and Starship.
cask "kitty"
cask "font-jetbrains-mono-nerd-font"

# Neovim and the tools its config uses: Git views, search, Sidekick (tmux), Pyright (node), Python projects (uv).
brew "neovim"
brew "git"
brew "ripgrep"
brew "fd"
brew "tmux"
brew "node"
brew "python"
brew "uv"

# Agent CLIs opened by Sidekick in Neovim.
cask "codex"
cask "claude-code@latest"

# Yazi file manager with video and PDF previews.
brew "yazi"
brew "ffmpeg"
brew "poppler"

# Starship prompt.
brew "starship"

# Secret scanning for commits to this public repository (.githooks/pre-commit).
brew "gitleaks"

# Other apps.
cask "visual-studio-code"
cask "google-chrome"
